    "@mui/material": "^9.4.0",
    "@tanstack/react-query": "^5.99.0",
    "axios": "^1.15.0",
    "keycloak-js": "^26.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
