      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (hikaricp_connections_active{namespace=~\"$namespace\", job=~\"$job\"})",
